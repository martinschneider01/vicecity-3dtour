{
  "name": "vicemap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "3D tour of the GTA: Vice City map in the browser (Three.js), built from the original game files.",
  "scripts": {
    "build:assets": "tsx tools/build-assets.ts",
    "dev": "vite --open",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --open",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:controls": "tsx scripts/test-controls.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "bench": "tsx scripts/bench.ts",
    "intro-image": "tsx scripts/intro-image.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "basis_universal": "^1.16.4-1",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "engines": {
    "node": ">=20"
  }
}
